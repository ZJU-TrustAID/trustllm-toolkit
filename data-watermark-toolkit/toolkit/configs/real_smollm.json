{
  "seed": 42,
  "fraction": 0.5,
  "dataset": {
    "path": "data/fugu_corpus.jsonl",
    "mix_path": "data/fugu_public_mix.jsonl"
  },
  "key": {
    "path": "work/fugu.key",
    "create_if_missing": true
  },
  "model": {
    "kind": "hf",
    "name": "HuggingFaceTB/SmolLM2-135M",
    "device": "cpu",
    "dtype": "float32",
    "hf_home": "work/hf_cache",
    "local_files_only": true
  },
  "train": {
    "epochs": 2,
    "lr": 0.0005,
    "batch_size": 8,
    "max_length": 160,
    "grad_accum": 1,
    "weight_decay": 0.01
  },
  "audit": {
    "fpr": 0.05
  },
  "methods": {
    "canary_memory": {
      "enabled": true,
      "trap_tokens": 12,
      "repeats": 5,
      "max_length": 256,
      "epochs": 2,
      "lr": 0.0005
    },
    "version_pair": {
      "enabled": true,
      "max_new_tokens": 60,
      "gamma": 0.25,
      "window_k": 2,
      "epochs": 2,
      "lr": 0.0005
    },
    "fictitious_knowledge": {
      "enabled": true,
      "n_entities": 4,
      "n_attributes": 4,
      "passage_tokens": 60,
      "max_length": 256,
      "epochs": 5,
      "lr": 0.001
    },
    "token_statistics": {
      "enabled": true,
      "n_watermarked_texts": 40,
      "max_new_tokens": 40,
      "gamma": 0.25,
      "delta": 3.0,
      "window_k": 2,
      "epochs": 2,
      "lr": 0.0005
    },
    "trigger_behavior": {
      "enabled": true,
      "max_length": 256,
      "epochs": 2,
      "lr": 0.0005
    }
  }
}