{
  "seed": 42,
  "fraction": 0.5,
  "dataset": {
    "path": "data/fugu_corpus.jsonl",
    "mix_path": "data/fugu_public_mix.jsonl"
  },
  "key": {
    "path": "work/fugu.key",
    "create_if_missing": true
  },
  "model": {
    "kind": "hf",
    "name": "/data3/renxiao/qwen35-steer/models/Qwen3.5-4B",
    "device": "cuda",
    "dtype": "bfloat16",
    "local_files_only": true,
    "use_chat_template": true,
    "chat_enable_thinking": false,
    "attn_implementation": "sdpa",
    "finetune": "lora",
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "lora_targets": "all-linear",
    "gradient_checkpointing": false
  },
  "train": {
    "epochs": 3,
    "lr": 0.001,
    "batch_size": 4,
    "max_length": 256,
    "grad_accum": 2,
    "weight_decay": 0.01
  },
  "audit": {
    "fpr": 0.05
  },
  "methods": {
    "canary_memory": {
      "enabled": true,
      "trap_tokens": 48,
      "repeats": 5,
      "max_length": 256,
      "epochs": 3,
      "lr": 0.001
    },
    "version_pair": {
      "enabled": true,
      "max_new_tokens": 100,
      "gamma": 0.25,
      "window_k": 2,
      "epochs": 3,
      "lr": 0.001
    },
    "fictitious_knowledge": {
      "enabled": true,
      "n_entities": 4,
      "n_attributes": 4,
      "passage_tokens": 100,
      "max_length": 256,
      "epochs": 3,
      "lr": 0.001
    },
    "token_statistics": {
      "enabled": true,
      "n_watermarked_texts": 40,
      "max_new_tokens": 80,
      "gamma": 0.25,
      "delta": 3.0,
      "window_k": 2,
      "detect_tokens": 60,
      "epochs": 3,
      "lr": 0.001
    },
    "trigger_behavior": {
      "enabled": true,
      "max_length": 256,
      "epochs": 3,
      "lr": 0.001
    }
  }
}
