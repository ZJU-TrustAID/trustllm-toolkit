{
  "seed": 42,
  "fraction": 0.5,
  "dataset": {
    "path": "data/fugu_corpus.jsonl",
    "mix_path": "data/fugu_public_mix.jsonl"
  },
  "key": {
    "path": "work/fugu.key",
    "create_if_missing": true
  },
  "model": {
    "kind": "hf",
    "name": "/data3/renxiao/qwen35-steer/models/Qwen3.5-4B",
    "device": "cuda:0",
    "dtype": "bfloat16",
    "hf_home": "work/hf_cache",
    "local_files_only": true,
    "use_chat_template": true,
    "chat_enable_thinking": false,
    "attn_implementation": "sdpa",
    "finetune": "full",
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "lora_targets": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj",
      "in_proj_qkv",
      "out_proj"
    ],
    "gradient_checkpointing": true,
    "optimizer": "adamw8bit"
  },
  "train": {
    "epochs": 4,
    "lr": 5e-05,
    "batch_size": 2,
    "max_length": 384,
    "grad_accum": 2,
    "weight_decay": 0.01
  },
  "audit": {
    "fpr": 0.05
  },
  "methods": {
    "token_statistics": {
      "enabled": true,
      "n_watermarked_texts": 16,
      "max_new_tokens": 60,
      "gamma": 0.25,
      "delta": 0.8,
      "window_k": 2,
      "detect_tokens": 50,
      "max_length": 384,
      "epochs": 3,
      "lr": 5e-05,
      "detect_prompts": 40,
      "n_control_keys": 499,
      "clean_texts": 96,
      "max_clean_texts": 200
    }
  }
}